{
  "name": "sistema-facturacion",
  "version": "1.1.0",
  "description": "Sistema de facturación y stock para supermercados (Paraguay)",
  "main": "dist/main/index.js",
  "author": "Marcos Arellano",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "build": {
    "appId": "com.marcosarellano.sistema-facturacion",
    "productName": "Sistema Facturacion",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sistema Facturación",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "verificar-entorno": "tsx scripts/verificarEntorno.ts",
    "probar-registrar-venta": "tsx scripts/probarRegistrarVenta.ts",
    "electron:fix": "tsx scripts/fixElectron.ts",
    "supabase:gen-types": "tsx scripts/generarTiposSupabase.ts",
    "icono": "python scripts/generar-icono.py build",
    "package": "npm run build && electron-builder --win --publish never",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "typecheck:main": "tsc --noEmit -p tsconfig.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^17.4.2",
    "electron-log": "^5.1.7",
    "electron-store": "^11.0.2",
    "exceljs": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
