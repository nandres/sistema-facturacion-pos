{
  "name": "sistema-facturacion",
  "version": "1.1.0",
  "description": "Sistema de facturación y stock para supermercados (Paraguay)",
  "main": "dist/main/index.js",
  "author": "Marcos Arellano",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "build": {
    "appId": "com.marcosarellano.sistema-facturacion",
    "productName": "Sistema Facturacion",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sistema Facturación",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "verificar-entorno": "tsx scripts/verificarEntorno.ts",
    "probar-registrar-venta": "tsx scripts/probarRegistrarVenta.ts",
    "electron:fix": "tsx scripts/fixElectron.ts",
    "supabase:gen-types": "tsx scripts/generarTiposSupabase.ts",
    "icono": "python scripts/generar-icono.py build",
    "package": "npm run typecheck && electron-builder --win",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "typecheck:main": "tsc --noEmit -p tsconfig.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "dotenv": "^17.4.2",
    "electron-log": "^5.1.7",
    "electron-store": "^10.0.0",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "electron": "^44.2.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.10.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
