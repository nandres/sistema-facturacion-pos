# Este archivo es para DESARROLLO.
#
# El instalador ya no lo lleva adentro. La conexion con la base se carga desde
# la propia aplicacion la primera vez que arranca --pantalla de configuracion
# inicial-- y queda guardada en esa maquina, cifrada con el almacen de Windows.
# Eso es lo que permite que un mismo instalador sirva para cualquier comercio,
# en vez de compilar uno por cliente con su .env adentro.
#
# Lo que se ponga aca siembra esa configuracion la primera vez, para no tener
# que cargarla a mano cada vez que se levanta `npm run dev`. En una caja ya
# instalada manda lo que este guardado, no este archivo.

# Configuración de base de datos Supabase
SUPABASE_URL=
# Clave publica del proyecto (Settings -> API -> Project API keys -> anon).
# Es la que usa el login de los cajeros contra Supabase Auth. Es publica por
# diseno: sin un usuario y su contrasena no abre nada, y desde C-02 el rol
# `anon` no tiene permisos sobre ninguna tabla.
SUPABASE_ANON_KEY=

# Llave maestra. Ignora RLS. Hoy sigue siendo el camino por defecto y el
# respaldo del login nuevo; se saca cuando Supabase Auth este probado en el
# mostrador (C-01).
SUPABASE_SERVICE_ROLE_KEY=

# Configuración de Hardware
TICKETERA_USB_ID=0x0416
TICKETERA_NOMBRE=5830 series
LECTOR_TIMEOUT=500

# Datos del comercio (opcional). Siembran la configuracion la primera vez que
# arranca una caja nueva; despues se editan desde la pantalla de Configuracion.
COMERCIO_NOMBRE=
COMERCIO_RUC=
