{
  // ── Por qué este archivo ────────────────────────────────────────────────
  // Sin él, VS Code marca en rojo el CSS del proyecto y en naranja cosas que
  // no son problemas. Nada de acá cambia el código: cambia lo que el editor
  // decide mostrarte.

  // `@tailwind` y `@apply` no son CSS estándar: los agrega el compilador de
  // Tailwind en el build. El validador nativo de VS Code no los conoce y los
  // marca como "Unknown at rule" — ese es el rojo de src/renderer/styles/index.css.
  // No es un error: el archivo compila perfecto.
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",

  // Usar el TypeScript del proyecto, no el que trae VS Code. Si las versiones
  // no coinciden, el editor marca errores que `npm run typecheck` no ve.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // Los imports se escriben relativos al proyecto, como en el resto del código.
  "typescript.preferences.importModuleSpecifier": "relative",

  // CRLF, igual que .gitattributes. Sin esto cada archivo que toque el editor
  // aparece entero como modificado en el diff.
  "files.eol": "\r\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // ESLint 9 con flat config.
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],

  // Tailwind IntelliSense también dentro de template strings de clases.
  "tailwindCSS.experimental.classRegex": [
    ["className\\s*=\\s*[\"'`]([^\"'`]*)", "([a-zA-Z0-9\\-:\\[\\]\\/\\.%!]+)"]
  ],

  // Ruido fuera del explorador y de la búsqueda.
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/out": true,
    "**/Backup": true,
    "**/.ui_backup*": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/out/**": true
  },

  // El dominio está en español: que el corrector no subraye media base de datos.
  "cSpell.language": "es,en"
}
